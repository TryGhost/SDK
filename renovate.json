{
  "extends": ["local>TryGhost/renovate-config:pnpm.json5"],
  "ignorePresets": [":pinDependencies"],
  "ignorePaths": ["packages/members"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "groupName": "rollup + plugins",
      "matchPackageNames": [
        "/^rollup/"
      ]
    },
    {
      "description": "ESLint 10 needs eslint-plugin-ghost to support it: its bundled rules call context APIs ESLint 10 removed",
      "matchPackageNames": [
        "eslint",
        "@eslint/js"
      ],
      "allowedVersions": "<10"
    }
  ]
}
