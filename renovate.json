{
  "extends": ["local>TryGhost/renovate-config:pnpm.json5"],
  "ignorePresets": [":pinDependencies"],
  "ignorePaths": ["packages/members"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "groupName": "rollup + plugins",
      "matchPackageNames": [
        "/^rollup/"
      ]
    },
    {
      "description": "ESLint 10 needs eslint-plugin-ghost to support it: its bundled rules call context APIs ESLint 10 removed",
      "matchPackageNames": [
        "eslint",
        "@eslint/js"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Keep Node types at the oldest Node version we test on, so code can't type-check against newer APIs",
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "<23"
    }
  ]
}
